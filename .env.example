# ============================================================
# PentestAI Unified — متغيرات البيئة
# انسخ لـ .env وعدّل القيم
# ============================================================

# Ollama (المحلي — يشتغل تلقائياً مع الجهاز)
OLLAMA_HOST=http://localhost:11434

# ─── 3 الموديلات المحلية (Ollama) ──────────────────────────
# xploiter/pentester:latest       — خبير الـ pentest
# qwen2.5-coder:14b               — كاتب الـ exploits
# WhiteRabbitNeo/Llama-3.1-WhiteRabbitNeo-2-8B:latest — offensive security

# ─── Taskade (اختياري) ─────────────────────────────────────
TASKADE_API_KEY=your_taskade_api_key_here

# ─── API Keys الأخرى (اختياري) ────────────────────────────
# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini (اختياري)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (مجاني وسريع جداً)
GROQ_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter (اختياري)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM
NVIDIA_API_KEY=

# ─── Proxy ─────────────────────────────────────────────────
BURPSUITE_PROXY=127.0.0.1:8080
ZAP_PROXY=127.0.0.1:8090
USE_PROXY=false

# ─── Web Server ────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=7070
DEBUG=false
