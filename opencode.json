{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "hunter-arsenal": {
      "type": "local",
      "command": ["python", "pentest.py", "mcp-serve"],
      "enabled": true,
      "timeout": 60000
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@2025.3.28", "."],
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "semgrep": {
      "type": "local",
      "command": ["uvx", "semgrep-mcp"],
      "enabled": false
    },
    "azure-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@azure/mcp@0.5.8", "server", "start"],
      "enabled": false
    },
    "github-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    }
  }
}
